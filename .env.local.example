# Copy to .env.local and fill in. .env.local is gitignored.
# Values come from your project dashboard at https://www.sanity.io/manage

# Required. Without this the site runs on placeholder content and /studio
# shows setup instructions instead of the Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# The dataset name. "production" is the default Sanity creates for you.
NEXT_PUBLIC_SANITY_DATASET=production

# Pin the API version. Bump deliberately, not automatically.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-08
